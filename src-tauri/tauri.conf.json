{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "fubemx",
  "version": "0.2.3",
  "identifier": "com.keysking.fubemx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "fubemx",
        "width": 1200,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/QingYiShiDeCha/FubeMX/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0RTI4MTJBQ0FGNEU1NjcKUldSbjVmVEtLb0hpeEFPSTZWVjBwaVh2WkMwWWlVMkRmbUFvKzEyUGFuaXVNMWNSVTZDYkJhTGUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
